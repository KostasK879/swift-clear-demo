NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SERVER-ONLY: Supabase service_role / secret key. Used by admin API routes to read bookings
# and manage blocked slots. Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
RESEND_API_KEY=re_your_key_here
# Force in-memory demo fallback even when Supabase env is set (1/true)
DEMO_MODE=1
# Admin area (/admin, GET /api/bookings, /api/blocked-slots) is protected by HTTP Basic Auth.
# If ADMIN_PASSWORD is unset, the admin area is disabled (fails closed).
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_to_a_long_random_password
