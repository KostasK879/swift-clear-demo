NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SERVER-ONLY: Supabase service_role / secret key. Used by admin API routes to read bookings
# and manage blocked slots. Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
RESEND_API_KEY=re_your_key_here
# Force in-memory demo fallback even when Supabase env is set (1/true)
DEMO_MODE=1
# Admin area (/admin, GET /api/bookings, /api/blocked-slots) is protected by HTTP Basic Auth.
# If ADMIN_PASSWORD is unset, the admin area is disabled (fails closed).
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_to_a_long_random_password

# --- Ellie / Vapi phone receptionist ---
# Shared secret checked on POST /api/vapi (optional but recommended)
VAPI_SECRET=
# Twilio for mid-call SMS. Without these, send_sms logs and succeeds in DEMO_MODE.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Used by scripts/setup-vapi.mjs (not read by Next at runtime)
# HUMAN_TRANSFER_NUMBER=+447xxxxxxxxx
# ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku

# --- Ellie in-browser voice (Vapi Web SDK) ---
# Create a PUBLIC key at https://dashboard.vapi.ai/org/api-keys (not the private key).
# Allowed Origins: http://localhost:3100
# Allowed Assistants: Swift Clear Receptionist
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=fe2e9be2-9621-4ec1-99b1-7f315d19f69c
# Optional: same public key without NEXT_PUBLIC_ (served via /api/vapi/web-config)
# VAPI_PUBLIC_KEY=
# Private key is SERVER-ONLY for scripts/setup-vapi.mjs — never NEXT_PUBLIC_
# VAPI_API_KEY=
